[Unit]
Description=MOQtail draft-18 Relay (Docker Compose)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/mitemau/deploy/relay
ExecStartPre=/usr/local/sbin/moqtail-relay-sync-certs
ExecStart=/usr/bin/docker compose -f /opt/mitemau/deploy/relay/compose.yaml up
ExecStop=/usr/bin/docker compose -f /opt/mitemau/deploy/relay/compose.yaml down --timeout 10
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
