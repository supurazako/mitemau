MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mitemau
MYSQL_USER=mitemau
MYSQL_PASSWORD='strong-password'
MYSQL_ROOT_PASSWORD='strong-password'

# Local email verification. Generate a secret with: openssl rand -hex 32
EMAIL_CODE_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@mitemau.test
SMTP_REQUIRE_TLS=false
# Defaults; change only when needed.
EMAIL_CODE_TTL=10m
REGISTRATION_TTL=30m
EMAIL_RESEND_INTERVAL=60s
EMAIL_MAX_ATTEMPTS=5
# Additional send protection and maintenance defaults.
EMAIL_MAX_SENDS_PER_SOURCE=20
EMAIL_SEND_WINDOW=1h
EMAIL_CLEANUP_INTERVAL=1h
# Trust only a loopback proxy that appends the actual client IP (Vite locally).
TRUST_LOOPBACK_PROXY=true

# WebAuthn: credentials are scoped to this RP ID. Local verification uses localhost.
WEBAUTHN_RP_ID=localhost
PASSKEY_CHALLENGE_TTL=5m
SESSION_TTL=24h
